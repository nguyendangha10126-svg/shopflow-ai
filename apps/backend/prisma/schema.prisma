datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum UserRole {
  OWNER
  STAFF
}

enum OrderStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderSource {
  CLIPBOARD
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

// -------------------------------------------------------------
// MULTI-TENANCY & BẢNG ĐẾM NGUYÊN TỬ
// -------------------------------------------------------------
model Shop {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(150)
  phone      String   @db.VarChar(20)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  users         User[]
  counter       ShopCounter?
  subscriptions Subscription[]
  products      Product[]
  variants      ProductVariant[]
  customers     Customer[]
  orders        Order[]
  faq_documents FaqDocument[]
  faq_chunks    FaqChunk[]
  ai_logs       AiLog[]
  audit_logs    AuditLog[]

  @@map("shops")
}

// Bảng đếm số thứ tự đơn hàng nguyên tử (QĐ-04)
model ShopCounter {
  id                String   @id @default(uuid()) @db.Uuid
  shop_id           String   @unique @db.Uuid
  last_order_number Int      @default(1000) // Bắt đầu từ 1000 để đơn đầu tiên là #1001
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@map("shop_counters")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  shop_id       String    @db.Uuid
  email         String    @unique @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  full_name     String    @db.VarChar(100)
  role          UserRole  @default(STAFF)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  shop               Shop                @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  orders_created     Order[]             @relation("OrdersCreatedBy")
  status_changes     OrderStatusHistory[]
  ai_logs            AiLog[]
  audit_logs         AuditLog[]

  @@index([shop_id, role])
  @@map("users")
}

model Plan {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String   @db.VarChar(100)
  code                    String   @unique @db.VarChar(50)
  price_vnd               Int      @default(0)
  max_products            Int      @default(20)
  max_orders_per_month    Int      @default(30)
  max_ai_drafts_per_month Int      @default(30)
  max_ai_faq_per_month    Int      @default(50)
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  shop_id    String             @db.Uuid
  plan_id    String             @db.Uuid
  status     SubscriptionStatus @default(TRIAL)
  starts_at  DateTime           @default(now()) @db.Timestamptz(6)
  expires_at DateTime           @db.Timestamptz(6)
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  updated_at DateTime           @updatedAt @db.Timestamptz(6)

  shop Shop @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@index([shop_id, status])
  @@map("subscriptions")
}

// -------------------------------------------------------------
// SẢN PHẨM & BIẾN THỂ TỒN KHO
// -------------------------------------------------------------
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  shop_id     String    @db.Uuid
  name        String    @db.VarChar(200)
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  is_active   Boolean   @default(true)
  deleted_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  shop     Shop             @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([shop_id, is_active])
  @@map("products")
}

model ProductVariant {
  id                  String    @id @default(uuid()) @db.Uuid
  shop_id             String    @db.Uuid
  product_id          String    @db.Uuid
  sku                 String    @db.VarChar(100)
  variant_name        String    @db.VarChar(150)
  size                String?   @db.VarChar(30)
  color               String?   @db.VarChar(50)
  price_vnd           Int       @default(0)
  stock               Int       @default(0)
  low_stock_threshold Int       @default(5)
  is_active           Boolean   @default(true)
  deleted_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  shop        Shop        @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  order_items OrderItem[]

  // SKU là duy nhất theo từng shop với các biến thể chưa bị soft-deleted
  @@unique([shop_id, sku])
  @@index([shop_id, stock])
  @@index([shop_id, product_id])
  @@map("product_variants")
}

// -------------------------------------------------------------
// KHÁCH HÀNG (DỮ LIỆU CÁ NHÂN PII)
// -------------------------------------------------------------
model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  shop_id         String    @db.Uuid
  name            String    @db.VarChar(100) // PII
  phone           String    @db.VarChar(20)  // PII
  address         String?   @db.Text         // PII
  total_spent_vnd BigInt    @default(0)
  total_orders    Int       @default(0)
  notes           String?   @db.Text
  deleted_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  shop   Shop    @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([shop_id, phone])
  @@index([shop_id, created_at])
  @@map("customers")
}

// -------------------------------------------------------------
// ĐƠN HÀNG & CHI TIẾT
// -------------------------------------------------------------
model Order {
  id               String      @id @default(uuid()) @db.Uuid // ID công khai duy nhất toàn hệ thống
  shop_id          String      @db.Uuid
  order_number     Int                                       // Số thứ tự tăng dần hiển thị #1001, #1002 (QĐ-04)
  customer_id      String?     @db.Uuid
  customer_name    String      @db.VarChar(100)              // Snapshot PII
  customer_phone   String      @db.VarChar(20)               // Snapshot PII
  shipping_address String      @db.Text                      // Snapshot PII
  status           OrderStatus @default(DRAFT)
  source           OrderSource @default(CLIPBOARD)
  subtotal_vnd     Int         @default(0)
  shipping_fee_vnd Int         @default(0)
  discount_vnd     Int         @default(0)
  total_vnd        Int         @default(0)
  notes            String?     @db.Text
  created_by       String?     @db.Uuid
  deleted_at       DateTime?   @db.Timestamptz(6)
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @updatedAt @db.Timestamptz(6)

  shop           Shop                 @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  customer       Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  creator        User?                @relation("OrdersCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  items          OrderItem[]
  status_history OrderStatusHistory[]
  draft_ai_meta  DraftAiMeta?

  // Đảm bảo số thứ tự đơn là duy nhất trong từng shop
  @@unique([shop_id, order_number])
  @@index([shop_id, status, created_at])
  @@index([shop_id, customer_id])
  @@map("orders")
}

model OrderItem {
  id                 String @id @default(uuid()) @db.Uuid
  order_id           String @db.Uuid
  product_variant_id String @db.Uuid
  snap_product_name  String @db.VarChar(200) // Snapshot tên bất biến
  snap_variant_name  String @db.VarChar(150) // Snapshot phân loại
  snap_sku           String @db.VarChar(100) // Snapshot SKU
  snap_price_vnd     Int                     // Snapshot giá bán
  quantity           Int    @default(1)
  subtotal_vnd       Int

  order   Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_variant_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  order_id    String      @db.Uuid
  from_status OrderStatus
  to_status   OrderStatus
  changed_by  String?     @db.Uuid
  reason      String?     @db.VarChar(255)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changed_by], references: [id], onDelete: SetNull)

  @@index([order_id, created_at])
  @@map("order_status_history")
}

// -------------------------------------------------------------
// DỮ LIỆU BÓC TÁCH AI & SIÊU DỮ LIỆU
// -------------------------------------------------------------
model DraftAiMeta {
  id                     String   @id @default(uuid()) @db.Uuid
  order_id               String   @unique @db.Uuid
  raw_anonymized_message String   @db.Text // Đã ẩn danh SĐT [PHONE_1]
  confidence_score       Float    @default(0.0)
  warning_flags          Json     @default("[]")
  ai_response_json       Json
  needs_clarification    Boolean  @default(false)
  questions_for_staff    Json     @default("[]")
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("draft_ai_meta")
}

// -------------------------------------------------------------
// FAQ DOCUMENTS & FULL-TEXT CHUNKS
// -------------------------------------------------------------
model FaqDocument {
  id           String   @id @default(uuid()) @db.Uuid
  shop_id      String   @db.Uuid
  title        String   @db.VarChar(200)
  content_type String   @default("POLICIES") @db.VarChar(50)
  raw_text     String   @db.Text
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  shop   Shop       @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  chunks FaqChunk[]

  @@index([shop_id, is_active])
  @@map("faq_documents")
}

model FaqChunk {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String   @db.Uuid
  document_id String   @db.Uuid
  chunk_index Int      @default(0)
  content     String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  shop     Shop        @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  document FaqDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([shop_id])
  @@index([document_id])
  @@map("faq_chunks")
}

// -------------------------------------------------------------
// AUDIT & GIÁM SÁT AI (TELEMETRY)
// -------------------------------------------------------------
model AiLog {
  id            String   @id @default(uuid()) @db.Uuid
  shop_id       String   @db.Uuid
  user_id       String?  @db.Uuid
  feature       String   @db.VarChar(50)
  model         String   @db.VarChar(100)
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  latency_ms    Int      @default(0)
  status        String   @db.VarChar(30)
  error_code    String?  @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  shop Shop  @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([shop_id, created_at])
  @@map("ai_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shop_id     String   @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   String   @db.VarChar(100)
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  shop Shop  @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([shop_id, created_at])
  @@map("audit_logs")
}

