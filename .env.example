# ==============================================================================
# SHOPFLOW AI - BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy:
#   cp .env.example .env
# ==============================================================================

# 1. Cấu hình Máy chủ Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 2. Cấu hình Cổng Container Docker (Optional)
BACKEND_PORT=5000
FRONTEND_PORT=80
POSTGRES_PORT=5432

# 3. Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_USER=shopflow_user
POSTGRES_PASSWORD=shopflow_secure_password_2026
POSTGRES_DB=shopflow_db

# Chuỗi kết nối Prisma (Cục bộ localhost:5432 hoặc Docker service postgres:5432)
# Chạy cục bộ:
DATABASE_URL="postgresql://shopflow_user:shopflow_secure_password_2026@localhost:5432/shopflow_db?schema=public"
# Chạy trong Docker Compose:
# DATABASE_URL="postgresql://shopflow_user:shopflow_secure_password_2026@postgres:5432/shopflow_db?schema=public"

# 4. Cấu hình Xác thực JWT (JSON Web Token)
# BẮT BUỘC đặt khóa riêng của bạn (>= 32 ký tự). Sinh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Để trống: máy dev dùng khóa tạm (có cảnh báo); production sẽ DỪNG ứng dụng.
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Chế độ DEMO: chỉ bật khi trình diễn KHÔNG có CSDL. Khi bật, lỗi DB sẽ hiện dữ liệu mẫu thay vì báo lỗi.
# TUYỆT ĐỐI để false khi chạy thật (production sẽ từ chối khởi động nếu bật).
DEMO_MODE=false

# 5. Cấu hình Trợ lý Trí tuệ Nhân tạo (AI Provider)
# AI_PROVIDER: "mock" (chế độ giả lập không tốn tiền API) hoặc "gemini" (Google Gemini 1.5 Flash)
AI_PROVIDER="mock"
GEMINI_API_KEY="your_google_ai_studio_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.1
